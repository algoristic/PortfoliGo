{
  "name": "PortfoliGo",
  "version": "0.6.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=4711 --open",
    "build": "ng build",
    "test": "npm run test:logic && npm run test:angular",
    "test:logic": "TZ=Pacific/Kiritimati vitest run --project logic",
    "test:angular": "TZ=Pacific/Kiritimati ng test --watch=false",
    "test:calibration": "TZ=Pacific/Kiritimati vitest run --project calibration",
    "test:perf": "vitest run --project perf",
    "test:mutation": "stryker run",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "e2e": "ng build && npm run test:e2e",
    "test:e2e": "playwright test --project=chromium --project=chromium-intl --project=mobile-chromium --grep-invert @budget && playwright test --project=chromium --grep @budget --workers=1",
    "budget": "node tools/check-bundle-budget.mjs www",
    "verify": "prettier --check . && ng lint && npm run i18n:check && npm run typecheck && npm test && npm run test:calibration && npm run test:perf && npm run test:mutation && npm run build && npm run budget && npm run test:e2e",
    "translate": "ng extract-i18n && node tools/i18n.mjs merge",
    "i18n:build": "node tools/i18n.mjs build",
    "i18n:check": "node tools/i18n.mjs check --strict",
    "lint": "ng lint --fix",
    "format": "npx prettier --write ."
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "22.2.6",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/localize": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/service-worker": "22.2.5",
    "@fontsource-variable/inter": "5.3.0",
    "@ngrx/effects": "22.0.0",
    "@ngrx/entity": "22.0.0",
    "@ngrx/operators": "22.0.0",
    "@ngrx/router-store": "22.0.0",
    "@ngrx/store": "22.0.0",
    "@ngrx/store-devtools": "22.0.0",
    "bootstrap-icons": "1.13.2",
    "idb": "8.0.3",
    "lightweight-charts": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@angular/language-service": "22.2.5",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "angular-eslint": "22.0.0",
    "eslint": "9.16.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "jsdom": "26.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.0.8"
  }
}
